  "search_strategy": {
    "databases": ["DBAASP", "DRAMP", "dbAMP", "APD6", "CAMPR4", "LAMP2"],
    "literature_sources": ["PubMed", "Scopus", "Web of Science"],
    "axes": {
      "axis_1_targets": ["Fusarium", "Xanthomonas", "Pseudomonas", "Erwinia", "Pectobacterium",
                          "Colletotrichum", "Botrytis", "Alternaria", "Magnaporthe", "Phytophthora", "Pythium"],
      "axis_2_intervention": ["antimicrobial peptide", "defensin", "thionin", "lipid transfer protein",
                               "hevein-like peptide", "cyclotide", "bacteriocin", "lipopeptide",
                               "peptaibol", "synthetic peptide"],
      "axis_3_agricultural": ["plant pathogen", "phytopathogen", "crop disease", "plant protection",
                               "biocontrol", "disease resistance", "postharvest"],
      "axis_4_experimental": ["MIC", "IC50", "growth inhibition", "spore germination",
                               "lesion reduction", "greenhouse", "field", "in planta"]
    },
    "appendix_d_queries": [
      "\"antimicrobial peptide\" AND Fusarium",
      "\"antimicrobial peptide\" AND Xanthomonas",
      "\"plant pathogen\" AND peptide AND MIC",
      "defensin AND phytopathogen",
      "peptaibol AND Trichoderma AND plant pathogen",
      "Bacillus lipopeptide AND Fusarium",
      "\"peptide conjugate\" AND Erwinia amylovora",
      "\"in planta\" AND antimicrobial peptide AND crop disease",
      "\"signal peptide\" AND secreted peptide AND Bacillus AND biocontrol",
      "\"small ORF\" AND antimicrobial peptide AND genome mining"
    ]
  },

  "benchmark_protocols": [
    {
      "id": "B1",
      "name": "Random Split",
      "usage": "Comparação metodológica apenas — nunca evidência principal",
      "description": "Split aleatório simples (80/20)"
    },
    {
      "id": "B2",
      "name": "Peptide ID Split",
      "usage": "Elimina repetição direta da mesma entidade",
      "description": "Divisão por peptide_id único"
    },
    {
      "id": "B3",
      "name": "Homology-Aware Split (RESULTADO PRINCIPAL)",
      "usage": "Resultado principal de avaliação",
      "description": "Split por cluster de similaridade — CD-HIT com thresholds 80%, 60%, 40%",
      "primary_threshold": 0.60,
      "sensitivity_thresholds": [0.80, 0.60, 0.40]
    },
    {
      "id": "B4",
      "name": "Holdout por Fonte/Tempo/Patógeno",
      "usage": "Avaliação de generalização",
      "description": "Holdout por base de dados de origem, janela temporal ou tipo de patógeno"
    }
  ],

  "modeling_tasks": [
    {
      "id": "T1",
      "name": "Binary Classification",
      "description": "Ativo vs Inativo com threshold explícito e análise de sensibilidade",
      "metrics": ["AUROC", "AUPRC", "F1", "MCC", "balanced_accuracy"],
      "priority": "primary"
    },
    {
      "id": "T2",
      "name": "Candidate Ranking",
      "description": "Ordenar candidatos por potencial relativo",
      "metrics": ["precision@k", "recall@k", "enrichment_factor", "NDCG"],
      "priority": "primary"
    },
    {
      "id": "T3",
      "name": "MIC Regression",
      "description": "Regressão quantitativa de MIC (apenas em subconjuntos homogêneos)",
      "metrics": ["RMSE_log2MIC", "MAE_log2MIC", "pct_within_1_dilution"],
      "priority": "conditional"
    }
  ],

  "model_comparison_line": [
    {"id": "M1", "name": "Classical descriptors + RF/XGBoost", "type": "baseline"},
    {"id": "M2", "name": "Frozen ESM-2 embeddings + lightweight classifier", "type": "transfer_strategy_1"},
    {"id": "M3", "name": "ESM-2 fine-tuning (supervised head)", "type": "transfer_strategy_2"},
    {"id": "M4", "name": "Two-step adaptation (AMP general → agricultural)", "type": "transfer_strategy_3"}
  ],

  "chemical_regimes": {
    "A": {
      "label": "Peptídeos ribossomais lineares com aminoácidos canônicos",
      "examples": ["defensinas lineares simples", "tioninas", "peptídeos sintéticos simples"],
      "representation": "sequence + descriptors + PLM embeddings",
      "modeling_priority": "first_cycle"
    },
    "B": {
      "label": "Peptídeos canônicos estruturalmente complexos",
      "examples": ["cíclicos", "pontes dissulfeto múltiplas", "amidados/acetilados"],
      "representation": "sequence + structural metadata + specific descriptors",
      "modeling_priority": "second_cycle"
    },
    "C": {
      "label": "Peptídeos com aminoácidos não canônicos / NRP / peptaibóis",
      "examples": ["peptaibóis de Trichoderma (Aib/Iva)", "surfactina", "fengicina", "iturina"],
      "representation": "SMILES / fingerprints / chemical ontology",
      "modeling_priority": "separate_or_contextual"
    },
    "D": {
      "label": "Evidências sem identidade química fechada",
      "examples": ["frações", "extratos", "misturas"],
      "representation": "contextual layer only — not in main training",
      "modeling_priority": "contextual_only"
    }
  },

  "genomic_pipeline": {
    "bacterial_arm": {
      "organisms": ["Bacillus", "Streptomyces"],
      "annotation_tools": ["Bakta>=1.9", "PGAP"],
      "bgc_tools": ["antiSMASH 8", "GECCO"],
      "amp_scanners": ["Macrel>=1.2", "ampir>=1.1", "AMPcombi>=0.2"],
      "signal_peptide": ["SignalP 6.0"],
      "clustering": "CD-HIT"
    },
    "fungal_arm": {
      "organisms": ["Trichoderma (fase 2, opcional)"],
      "annotation_tools": ["BRAKER3", "GeneMark-ETP"],
      "secretome": ["SignalP 6.0", "TargetP 2.0", "ApoplastP"],
      "bgc_tools": ["antiSMASH fungal modules"],
      "status": "optional_phase2"
    }
  },

  "translational_flags": [
    {"flag": "flag_length_ok",       "description": "Comprimento adequado (tipicamente 5–50 aa para lineares)"},
    {"flag": "flag_canonical",       "description": "Apenas aminoácidos canônicos (sintetizável por Fmoc/SPPS padrão)"},
    {"flag": "flag_synthesizable",   "description": "Sintetizável — sem ciclagem complexa, lipídeos ou NRP"},
    {"flag": "flag_low_phytotox",    "description": "Baixa fitotoxicidade reportada ou prevista"},
    {"flag": "flag_low_hemolysis",   "description": "HC50/MIC ≥ 10 (índice de seletividade mínimo)"},
    {"flag": "flag_stable",          "description": "Evidência de estabilidade contra proteases ou condições agrícolas"}
  ],

  "reproducibility": {
    "version_control": "Git (GitHub)",
    "workflow_manager": "Snakemake >= 8",
    "containerization": ["Docker", "Apptainer/Singularity"],
    "environment_management": "MAMBA/Conda",
    "experiment_tracking": "MLflow",
    "dataset_versioning": "dataset_version table (PostgreSQL)",
    "model_cards": "docs/model_card.md",
    "data_cards": "docs/data_card.md"
  }
}
