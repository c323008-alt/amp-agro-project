{
  "_metadata": {
    "platform": "H4i — SENAI CIMATEC",
    "dataset_id": "PHYTOAMP-DS-001",
    "dataset_name": "PhytoAMP: Curated Assay-Level Database of Antimicrobial Peptides Against Phytopathogens",
    "version": "v0.1",
    "created_at": "2025-01-01T00:00:00Z",
    "license": "CC BY 4.0",
    "doi_placeholder": "10.XXXXX/phytoamp.v0",
    "language": "pt-BR / en",
    "institution": "SENAI CIMATEC",
    "program": "Mestrado em Modelagem Computacional e Tecnologia Industrial",
    "contact": "phytoamp@senaicimatec.edu.br",
    "keywords": [
      "antimicrobial peptides", "AMPs", "phytopathogens", "agricultural biotechnology",
      "machine learning", "curated database", "assay-level", "transfer learning",
      "ESM-2", "benchmarking", "genomic mining", "biocontrol"
    ],
    "citation": "PhytoAMP Team. (2025). PhytoAMP: A curated assay-level database of antimicrobial peptides against phytopathogens. SENAI CIMATEC."
  },

  "project_description": {
    "title": "Recurso Curado e Orientado a Contexto Agrícola para AMPs Contra Fitopatógenos",
    "central_question": "Um recurso curado, orientado a contexto agrícola e estruturado no nível de ensaio, permite construir modelos mais úteis para priorização de AMPs contra fitopatógenos do que a simples reutilização de bases AMP genéricas?",
    "general_objective": "Desenvolver um recurso curado e orientado a contexto agrícola, acompanhado de estratégias preditivas e de priorização, para apoiar a prospecção de peptídeos antimicrobianos com potencial de atividade contra fitopatógenos de relevância agrícola.",
    "hypotheses": [
      {
        "id": "H1",
        "label": "Valor da curadoria orientada a domínio",
        "statement": "Modelos ajustados com conjunto curado e orientado a contexto agrícola alteram a ordenação dos candidatos e melhoram a priorização em avaliação externa-like, quando comparados a modelos treinados apenas com dados AMP genéricos."
      },
      {
        "id": "H2",
        "label": "Rigor do benchmark",
        "statement": "A avaliação com splits homology-aware e controle por peptide_id/cluster produz não apenas métricas mais conservadoras, mas também listas de candidatos prioritários substancialmente diferentes das obtidas com splits aleatórios."
      },
      {
        "id": "H3",
        "label": "Utilidade do caso de uso genômico",
        "statement": "A combinação entre filtros biológicos, modelos ajustados ao domínio agrícola e regras transparentes de priorização enriquece a seleção de candidatos promissores, em relação a baselines baseados apenas em homologia."
      },
      {
        "id": "H4",
        "label": "Heterogeneidade química importa",
        "statement": "A inclusão indiscriminada de peptídeos não canônicos, NRPs e peptaibóis no mesmo espaço de modelagem de peptídeos lineares canônicos reduz a coerência representacional."
      },
      {
        "id": "H5",
        "label": "Transfer learning como estratégia de domínio",
        "statement": "Estratégias de transfer learning partindo de representações pré-treinadas em dados proteicos ou AMP gerais tendem a superar treinamento do zero quando o conjunto agrícola curado é pequeno ou moderado."
      }
    ]
  },

  "schema": {
    "entities": [
      "peptide", "peptide_chemistry", "activity_assay", "target_pathogen",
      "host_plant", "assay_condition", "evidence_layer", "toxicity_record",
      "stability_record", "mechanism_annotation", "reference",
      "curation_event", "genomic_candidate", "model_prediction",
      "feature_set", "feature_value"
    ],
    "central_table": "activity_assay",
    "organization_principle": "assay-level (not peptide-level)",
    "evidence_model": "orthogonal_5_dimensions"
  },

  "data_schema": {
    "fields": [
      {"name": "peptide_id",          "type": "uuid",    "description": "Identificador único estável do peptídeo"},
      {"name": "internal_code",       "type": "string",  "description": "Código PhytoAMP (ex: PHYTOAMP-00001)"},
      {"name": "sequence_fasta",      "type": "string",  "description": "Sequência primária em formato FASTA"},
      {"name": "sequence_status",     "type": "enum",    "values": ["exact", "partial", "inferred", "synthetic"]},
      {"name": "length_aa",           "type": "integer", "description": "Comprimento em aminoácidos"},
      {"name": "chemical_regime",     "type": "enum",    "values": ["A", "B", "C", "D"],
       "description": "A=linear canônico, B=canônico complexo, C=não canônico/NRP/peptaibol, D=sem identidade fechada"},
      {"name": "is_canonical",        "type": "boolean", "description": "Apenas 20 aminoácidos padrão"},
      {"name": "is_linear",           "type": "boolean"},
      {"name": "amp_class",           "type": "string",  "description": "Classe AMP funcional (defensin, thionin, LTP, etc.)"},
      {"name": "chemical_class",      "type": "string",  "description": "Classe química (separada da classe AMP)"},
      {"name": "target_tax_id",       "type": "integer", "description": "NCBI Taxonomy ID do fitopatógeno alvo"},
      {"name": "target_species",      "type": "string",  "description": "Nome da espécie alvo"},
      {"name": "pathogen_type",       "type": "enum",    "values": ["bacteria", "true_fungi", "oomycete", "other"]},
      {"name": "endpoint_type",       "type": "enum",    "values": ["MIC", "MBC", "MFC", "IC50", "EC50",
                                                                      "pct_growth_inhibition", "halo_mm", "other"]},
      {"name": "endpoint_value_raw",  "type": "float",   "description": "Valor bruto exatamente como reportado"},
      {"name": "endpoint_operator",   "type": "enum",    "values": ["=", ">", "<", ">=", "<="],
       "description": "Operador de censura do MIC"},
      {"name": "endpoint_unit",       "type": "string",  "description": "Unidade do endpoint (µM, µg/mL, etc.)"},
      {"name": "endpoint_log2",       "type": "float",   "description": "log2(MIC) calculado quando aplicável"},
      {"name": "is_censored",         "type": "boolean", "description": "Indica MIC censurado"},
      {"name": "train_eligible",      "type": "boolean", "description": "Elegível para treino ML"},
      {"name": "train_level",         "type": "integer", "description": "1=treinável, 2=contextual"},
      {"name": "activity_zone",       "type": "enum",    "values": ["active", "grey", "inactive", "not_classified"]},
      {"name": "experiment_type",     "type": "enum",    "values": ["in_silico", "in_vitro", "ex_vivo", "in_planta",
                                                                      "greenhouse", "field", "product_formulation"]},
      {"name": "evidence_type",       "type": "string",  "description": "Dimensão 1 do modelo ortogonal"},
      {"name": "experimental_rigor",  "type": "enum",    "values": ["exploratory", "partially_standardized",
                                                                      "standardized", "well_controlled"]},
      {"name": "agricultural_relevance","type": "enum",  "values": ["indirect", "moderate", "direct"]},
      {"name": "agent_identity",      "type": "enum",    "values": ["exact_sequence", "partial_sequence",
                                                                      "mixture", "fraction", "formulation"]},
      {"name": "host_plant",          "type": "string",  "description": "Espécie da planta hospedeira"},
      {"name": "protocol_standard",   "type": "enum",    "values": ["CLSI_M07", "CLSI_M38", "EUCAST", "custom"]},
      {"name": "source_doi",          "type": "string",  "description": "DOI da referência"},
      {"name": "source_db",           "type": "string",  "description": "Base de dados de origem (DBAASP, DRAMP, etc.)"}
    ]
  },

